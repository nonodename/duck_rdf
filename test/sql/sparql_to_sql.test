# name: test/sql/sparql_to_sql.test
# description: test sparql_to_sql SPARQL-to-SQL translation
# group: [sql]

require rdf

# ── Setup ─────────────────────────────────────────────────────────────────────
# Same table shape as write_rdf.test, mapped by test/r2rml/full_r2rml_lower.ttl
# (rr:logicalTable [ rr:tableName "emp" ], lowercase column refs matching
# DuckDB's unquoted-identifier folding).

statement ok
CREATE TABLE emp AS SELECT 7369 AS EMPNO, 'SMITH' AS ENAME, 10 AS DEPTNO;

# ── Success: translate ───────────────────────────────────────────────────────

query T
SELECT sparql_to_sql(
    'PREFIX ex: <http://example.com/ns#> SELECT ?e ?name WHERE { ?e ex:name ?name }',
    'test/r2rml/full_r2rml_lower.ttl'
);
----
SELECT DISTINCT ('http://data.example.com/employee/' || url_encode(CAST(t1."empno" AS VARCHAR))) AS "v_e", t1."ename" AS "v_name" FROM "emp" AS t1 WHERE (t1."empno" IS NOT NULL) AND (t1."ename" IS NOT NULL)

# Same query/mapping via YARRRML (.yml) — proves format-by-extension dispatch
# produces the same translation as the R2RML Turtle mapping.
query T
SELECT sparql_to_sql(
    'PREFIX ex: <http://example.com/ns#> SELECT ?e ?name WHERE { ?e ex:name ?name }',
    'test/r2rml/full_r2rml_lower.yml'
);
----
SELECT DISTINCT ('http://data.example.com/employee/' || url_encode(CAST(t1."empno" AS VARCHAR))) AS "v_e", t1."ename" AS "v_name" FROM "emp" AS t1 WHERE (t1."empno" IS NOT NULL) AND (t1."ename" IS NOT NULL)

# ── Success: round-trip execute ──────────────────────────────────────────────
# The exact SQL text produced above, pasted literally and executed against the
# same emp table, must return the row the SPARQL query asked for. This is the
# real correctness oracle: sparql_to_sql's job is to produce SQL that actually
# runs and means the same thing as the SPARQL query.

query TT
SELECT (t3."v_e") AS "v_e", (t3."v_name") AS "v_name" FROM (SELECT DISTINCT ('http://data.example.com/employee/' || CAST(t1."empno" AS VARCHAR)) AS "v_e", CAST(t1."ename" AS VARCHAR) AS "v_name" FROM "emp" AS t1 WHERE (t1."empno" IS NOT NULL) AND (t1."ename" IS NOT NULL)) AS t3;
----
http://data.example.com/employee/7369	SMITH

# ── Error cases ───────────────────────────────────────────────────────────────

# mapping file not found
statement error
SELECT sparql_to_sql('SELECT ?e WHERE { ?e ?p ?o }', 'test/r2rml/nonexistent.ttl');
----
Mapping file not found

# mapping is inside-out-only (no rr:logicalTable) - not enough for translation
statement error
SELECT sparql_to_sql(
    'PREFIX ex: <http://example.com/ns#> SELECT ?e ?name WHERE { ?e ex:name ?name }',
    'test/r2rml/inside_out.ttl'
);
----
not a valid full R2RML mapping

# malformed SPARQL syntax
statement error
SELECT sparql_to_sql('SELECT ?e WHERE { ?e ?p ?o', 'test/r2rml/full_r2rml_lower.ttl');
----
SPARQL parse error

# unsupported query form: CONSTRUCT
statement error
SELECT sparql_to_sql(
    'PREFIX ex: <http://example.com/ns#> CONSTRUCT { ?e ex:name ?name } WHERE { ?e ex:name ?name }',
    'test/r2rml/full_r2rml_lower.ttl'
);
----
SPARQL-to-SQL translation error

# GRAPH pattern now supported. full_r2rml_lower.ttl has no rr:graph/rr:graphMap
# anywhere, so every candidate's graph set is empty and GRAPH can never bind -
# this is the degenerate case; see "Named graphs" below for a mapping that
# actually has graph maps to translate against.
query T
SELECT sparql_to_sql(
    'PREFIX ex: <http://example.com/ns#> SELECT ?e ?name WHERE { GRAPH ?g { ?e ex:name ?name } }',
    'test/r2rml/full_r2rml_lower.ttl'
);
----
SELECT (t3."v_e") AS "v_e", (t3."v_name") AS "v_name" FROM (SELECT CAST(NULL AS VARCHAR) AS "v_e", CAST(NULL AS VARCHAR) AS "v_name", CAST(NULL AS VARCHAR) AS "v_g" WHERE FALSE) AS t3

# property path in predicate position
query T
SELECT sparql_to_sql(
    'PREFIX ex: <http://example.com/ns#> SELECT ?e ?name WHERE { ?e ex:name+ ?name }',
    'test/r2rml/full_r2rml_lower.ttl'
);
----
WITH RECURSIVE cte1 AS (SELECT DISTINCT ('http://data.example.com/employee/' || url_encode(CAST(t1."empno" AS VARCHAR))) AS "v_%p1", t1."ename" AS "v_%p2" FROM "emp" AS t1 WHERE (t1."empno" IS NOT NULL) AND (t1."ename" IS NOT NULL)), cte2 AS (SELECT t3."v_%p1" AS "cte_from", t3."v_%p2" AS "cte_to" FROM cte1 AS t3 UNION SELECT t5."cte_from", t4."v_%p2" FROM cte2 AS t5 JOIN cte1 AS t4 ON t5."cte_to" = t4."v_%p1") SELECT t6."cte_from" AS "v_e", t6."cte_to" AS "v_name" FROM cte2 AS t6

# ── Type catalog from rr:sqlQuery views ────────────────────────────────────────
# test/r2rml/view_types.ttl maps ex:label from BOTH emp.ename (a plain table,
# typed via information_schema) and an rr:sqlQuery view over dept (which
# appears in no information_schema at all), and ex:namelen from a *computed*
# view column (LENGTH(...)) with no base-table equivalent whatsoever. Neither
# datatype is declared via rr:datatype, so DATATYPE() can only answer if the
# type catalog describes the views' result columns, not just the base tables
# - which is exactly what sql2rdf::loadTypeCatalog adds on top of the plain
# information_schema sweep.

statement ok
CREATE TABLE dept AS SELECT 10 AS DEPTNO, 'ACCOUNTING' AS DNAME;

query T
SELECT sparql_to_sql(
    'PREFIX ex: <http://example.com/ns#> PREFIX xsd: <http://www.w3.org/2001/XMLSchema#> '
    'SELECT ?l WHERE { ?s ex:label ?l . FILTER(datatype(?l) = xsd:string) }',
    'test/r2rml/view_types.ttl'
) LIKE '%XMLSchema#string%';
----
true

query T
SELECT sparql_to_sql(
    'PREFIX ex: <http://example.com/ns#> PREFIX xsd: <http://www.w3.org/2001/XMLSchema#> '
    'SELECT ?n WHERE { ?s ex:namelen ?n . FILTER(datatype(?n) = xsd:integer) }',
    'test/r2rml/view_types.ttl'
) LIKE '%XMLSchema#integer%';
----
true

# ── Named graphs (sql2rdf v2.2.0) ──────────────────────────────────────────────
# test/r2rml/full_r2rml_graph_sparql.ttl (full R2RML, same "emp" table as
# full_r2rml_lower.ttl above): the subject map has a CONSTANT rr:graph
# <.../g1>, so every triple of the TriplesMap - including ex:name, which has
# no graph of its own - inherits it. ex:department additionally has its own
# rr:graphMap (a per-row TEMPLATE keyed on deptno), so per R2RML section 12
# its triples are in the UNION of <.../g1> and a department-specific graph.

# GRAPH with a bound constant IRI: matches, since ex:name is (only) in g1.
query T
SELECT sparql_to_sql(
    'PREFIX ex: <http://example.com/ns#> SELECT ?e ?name WHERE { GRAPH <http://example.com/graph/g1> { ?e ex:name ?name } }',
    'test/r2rml/full_r2rml_graph_sparql.ttl'
);
----
SELECT DISTINCT ('http://data.example.com/employee/' || url_encode(CAST(t1."empno" AS VARCHAR))) AS "v_e", t1."ename" AS "v_name" FROM "emp" AS t1 WHERE (t1."empno" IS NOT NULL) AND (t1."ename" IS NOT NULL)

# GRAPH ?g binds the graph as an ordinary query variable.
query T
SELECT sparql_to_sql(
    'PREFIX ex: <http://example.com/ns#> SELECT ?e ?name ?g WHERE { GRAPH ?g { ?e ex:name ?name } }',
    'test/r2rml/full_r2rml_graph_sparql.ttl'
);
----
SELECT DISTINCT ('http://data.example.com/employee/' || url_encode(CAST(t1."empno" AS VARCHAR))) AS "v_e", t1."ename" AS "v_name", 'http://example.com/graph/g1' AS "v_g" FROM "emp" AS t1 WHERE (t1."empno" IS NOT NULL) AND (t1."ename" IS NOT NULL)

# ex:department's graph set has two members, so GRAPH ?g must yield one
# solution per graph - a UNION over the two graph shapes, one constant
# ("g1", inherited from the subject map) and one per-row template.
query T
SELECT sparql_to_sql(
    'PREFIX ex: <http://example.com/ns#> SELECT ?e ?d ?g WHERE { GRAPH ?g { ?e ex:department ?d } }',
    'test/r2rml/full_r2rml_graph_sparql.ttl'
);
----
(SELECT DISTINCT ('http://data.example.com/employee/' || url_encode(CAST(t2."empno" AS VARCHAR))) AS "v_e", ('http://data.example.com/department/' || url_encode(CAST(t2."deptno" AS VARCHAR))) AS "v_d", 'http://example.com/graph/g1' AS "v_g" FROM "emp" AS t2 WHERE (t2."empno" IS NOT NULL) AND (t2."deptno" IS NOT NULL)) UNION BY NAME (SELECT DISTINCT ('http://data.example.com/employee/' || url_encode(CAST(t2."empno" AS VARCHAR))) AS "v_e", ('http://data.example.com/department/' || url_encode(CAST(t2."deptno" AS VARCHAR))) AS "v_d", ('http://example.com/graph/dept/' || url_encode(CAST(t2."deptno" AS VARCHAR))) AS "v_g" FROM "emp" AS t2 WHERE (('http://example.com/graph/dept/' || url_encode(CAST(t2."deptno" AS VARCHAR))) <> 'http://www.w3.org/ns/r2rml#defaultGraph') AND (t2."empno" IS NOT NULL) AND (t2."deptno" IS NOT NULL))

# Round-trip: pasting the ex:department UNION SQL above literally must return
# both graphs the triple belongs to for the one row in "emp".
query TTT
(SELECT DISTINCT ('http://data.example.com/employee/' || url_encode(CAST(t2."empno" AS VARCHAR))) AS "v_e", ('http://data.example.com/department/' || url_encode(CAST(t2."deptno" AS VARCHAR))) AS "v_d", 'http://example.com/graph/g1' AS "v_g" FROM "emp" AS t2 WHERE (t2."empno" IS NOT NULL) AND (t2."deptno" IS NOT NULL)) UNION BY NAME (SELECT DISTINCT ('http://data.example.com/employee/' || url_encode(CAST(t2."empno" AS VARCHAR))) AS "v_e", ('http://data.example.com/department/' || url_encode(CAST(t2."deptno" AS VARCHAR))) AS "v_d", ('http://example.com/graph/dept/' || url_encode(CAST(t2."deptno" AS VARCHAR))) AS "v_g" FROM "emp" AS t2 WHERE (('http://example.com/graph/dept/' || url_encode(CAST(t2."deptno" AS VARCHAR))) <> 'http://www.w3.org/ns/r2rml#defaultGraph') AND (t2."empno" IS NOT NULL) AND (t2."deptno" IS NOT NULL))
ORDER BY v_g;
----
http://data.example.com/employee/7369	http://data.example.com/department/10	http://example.com/graph/dept/10
http://data.example.com/employee/7369	http://data.example.com/department/10	http://example.com/graph/g1

# FROM <g1> restricts the default graph to g1's triples - equivalent to the
# bound-GRAPH query above but expressed via a dataset clause instead.
query T
SELECT sparql_to_sql(
    'PREFIX ex: <http://example.com/ns#> SELECT ?e ?name FROM <http://example.com/graph/g1> WHERE { ?e ex:name ?name }',
    'test/r2rml/full_r2rml_graph_sparql.ttl'
);
----
SELECT DISTINCT ('http://data.example.com/employee/' || url_encode(CAST(t1."empno" AS VARCHAR))) AS "v_e", t1."ename" AS "v_name" FROM "emp" AS t1 WHERE (t1."empno" IS NOT NULL) AND (t1."ename" IS NOT NULL)

# With NO dataset clause and NO GRAPH block, strict RDF-dataset semantics say
# the default graph holds only triples whose graph set is empty or names
# rr:defaultGraph - every triple in this mapping has an explicit named graph,
# so an ungraphed query against it matches nothing. This is the documented
# behaviour change from before sql2rdf v2.2.0 (mappings using rr:graph now
# need an explicit GRAPH/FROM to see their triples).
query T
SELECT sparql_to_sql(
    'PREFIX ex: <http://example.com/ns#> SELECT ?e ?name WHERE { ?e ex:name ?name }',
    'test/r2rml/full_r2rml_graph_sparql.ttl'
);
----
SELECT CAST(NULL AS VARCHAR) AS "v_e", CAST(NULL AS VARCHAR) AS "v_name" WHERE FALSE