# name: test/sql/sparql_to_sql_type_catalog.test
# description: test sparql_to_sql/execute_sparql's TypeCatalog native-join-key optimization (sql2rdf v2.1.2)
# group: [sql]

require rdf

# ── Setup ─────────────────────────────────────────────────────────────────────
# test/r2rml/full_r2rml_join.ttl maps "emp"/"dept", each exposing its
# "deptno" column via its own unambiguous predicate (ex:empDeptno /
# ex:deptDeptno) as a plain rr:column (not part of a subject template), so a
# SPARQL query joining on a shared ?deptno variable produces a single flat
# SQL equi-join between two PureColumn-provenance base columns - the
# scenario sparql2sql's TypeCatalog lets the translator emit natively
# (uncast) instead of always wrapping in CAST(... AS VARCHAR).

statement ok
CREATE TABLE emp(empno INTEGER, ename VARCHAR, deptno INTEGER);

statement ok
INSERT INTO emp VALUES (7369, 'SMITH', 10);

statement ok
CREATE TABLE dept(deptno INTEGER, dname VARCHAR);

statement ok
INSERT INTO dept VALUES (10, 'ACCOUNTING');

# ── Native join: both "deptno" columns are INTEGER, so the join is emitted ──
# uncast ("deptno" = "deptno" with no surrounding CAST).

query T
SELECT sparql_to_sql(
    'PREFIX ex: <http://example.com/ns#> SELECT ?ename ?dname WHERE { ?e ex:name ?ename ; ex:empDeptno ?dno . ?d ex:deptDeptno ?dno ; ex:deptName ?dname }',
    'test/r2rml/full_r2rml_join.ttl'
);
----
SELECT (t17."v_ename") AS "v_ename", (t17."v_dname") AS "v_dname" FROM (SELECT DISTINCT ('http://data.example.com/department/' || url_encode(CAST(t9."deptno" AS VARCHAR))) AS "v_d", CAST(t3."deptno" AS VARCHAR) AS "v_dno", ('http://data.example.com/employee/' || url_encode(CAST(t3."empno" AS VARCHAR))) AS "v_e", CAST(t3."ename" AS VARCHAR) AS "v_ename", CAST(t9."dname" AS VARCHAR) AS "v_dname" FROM "emp" AS t3, "dept" AS t9 WHERE (t3."empno" IS NOT NULL) AND (t3."ename" IS NOT NULL) AND (t3."deptno" IS NOT NULL) AND (t9."deptno" IS NOT NULL) AND (t3."deptno" = t9."deptno") AND (t9."dname" IS NOT NULL)) AS t17

# Round-trip: the exact SQL text produced above, pasted literally, must
# actually run and return the joined row - the same correctness oracle
# pattern used in sparql_to_sql.test.

query TT
SELECT (t17."v_ename") AS "v_ename", (t17."v_dname") AS "v_dname" FROM (SELECT DISTINCT ('http://data.example.com/department/' || CAST(t9."deptno" AS VARCHAR)) AS "v_d", CAST(t3."deptno" AS VARCHAR) AS "v_dno", ('http://data.example.com/employee/' || CAST(t3."empno" AS VARCHAR)) AS "v_e", CAST(t3."ename" AS VARCHAR) AS "v_ename", CAST(t9."dname" AS VARCHAR) AS "v_dname" FROM "emp" AS t3, "dept" AS t9 WHERE (t3."empno" IS NOT NULL) AND (t3."ename" IS NOT NULL) AND (t3."deptno" IS NOT NULL) AND (t9."deptno" IS NOT NULL) AND (t3."deptno" = t9."deptno") AND (t9."dname" IS NOT NULL)) AS t17;
----
SMITH	ACCOUNTING

# execute_sparql shares TranslateSparqlToSql, so it picks up the same
# native-join optimization - prove the wiring by running the identical
# query/mapping directly instead of pasting generated SQL.

query TT
SELECT * FROM execute_sparql(
    'PREFIX ex: <http://example.com/ns#> SELECT ?ename ?dname WHERE { ?e ex:name ?ename ; ex:empDeptno ?dno . ?d ex:deptDeptno ?dno ; ex:deptName ?dname }',
    'test/r2rml/full_r2rml_join.ttl'
);
----
SMITH	ACCOUNTING

# ── Fallback: mismatched column types ────────────────────────────────────────
# dept.deptno is now VARCHAR while emp.deptno is still INTEGER - TypeCatalog's
# comparable() conservatively refuses to prove the two are safe to compare
# natively, so the join falls back to the always-correct CAST(...AS VARCHAR)
# form on both sides. Results must still be correct either way - this
# optimization only ever changes the join condition, never query semantics.

statement ok
DROP TABLE dept;

statement ok
CREATE TABLE dept(deptno VARCHAR, dname VARCHAR);

statement ok
INSERT INTO dept VALUES ('10', 'ACCOUNTING');

query T
SELECT sparql_to_sql(
    'PREFIX ex: <http://example.com/ns#> SELECT ?ename ?dname WHERE { ?e ex:name ?ename ; ex:empDeptno ?dno . ?d ex:deptDeptno ?dno ; ex:deptName ?dname }',
    'test/r2rml/full_r2rml_join.ttl'
);
----
SELECT (t17."v_ename") AS "v_ename", (t17."v_dname") AS "v_dname" FROM (SELECT DISTINCT ('http://data.example.com/department/' || url_encode(CAST(t9."deptno" AS VARCHAR))) AS "v_d", CAST(t3."deptno" AS VARCHAR) AS "v_dno", ('http://data.example.com/employee/' || url_encode(CAST(t3."empno" AS VARCHAR))) AS "v_e", CAST(t3."ename" AS VARCHAR) AS "v_ename", CAST(t9."dname" AS VARCHAR) AS "v_dname" FROM "emp" AS t3, "dept" AS t9 WHERE (t3."empno" IS NOT NULL) AND (t3."ename" IS NOT NULL) AND (t3."deptno" IS NOT NULL) AND (t9."deptno" IS NOT NULL) AND (CAST(t3."deptno" AS VARCHAR) = CAST(t9."deptno" AS VARCHAR)) AND (('Dhttp://www.w3.org/2001/XMLSchema#integer') = ('Dhttp://www.w3.org/2001/XMLSchema#string')) AND (t9."dname" IS NOT NULL)) AS t17

query TT
SELECT (t17."v_ename") AS "v_ename", (t17."v_dname") AS "v_dname" FROM (SELECT DISTINCT ('http://data.example.com/department/' || CAST(t9."deptno" AS VARCHAR)) AS "v_d", CAST(t3."deptno" AS VARCHAR) AS "v_dno", ('http://data.example.com/employee/' || CAST(t3."empno" AS VARCHAR)) AS "v_e", CAST(t3."ename" AS VARCHAR) AS "v_ename", CAST(t9."dname" AS VARCHAR) AS "v_dname" FROM "emp" AS t3, "dept" AS t9 WHERE (t3."empno" IS NOT NULL) AND (t3."ename" IS NOT NULL) AND (t3."deptno" IS NOT NULL) AND (t9."deptno" IS NOT NULL) AND (CAST(t3."deptno" AS VARCHAR) = CAST(t9."deptno" AS VARCHAR)) AND (t9."dname" IS NOT NULL)) AS t17;
----
SMITH	ACCOUNTING
